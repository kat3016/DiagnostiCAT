# Configuración para DiagnostiCAT con Nemotron
# Copia este archivo como .env y completa tu API key

# NVIDIA NEMOTRON (REQUERIDO)
NVIDIA_API_KEY=tu_nvidia_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# CONFIGURACIÓN DE LLM
LLM_PROVIDER=nemotron
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# CREWAI
CREW_ENABLE=True

# BÁSICO
DEBUG=False
HOST=0.0.0.0
PORT=8000

# BASE DE DATOS
DATABASE_URL=sqlite:///./diagnosticat.db
